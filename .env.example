# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the pooler (port 6543, "Transaction" mode) — used by the app.
# DIRECT_URL is the session pooler (port 5432) — used by drizzle-kit only.
# Both are pooler hosts on purpose. The "Direct connection" string Supabase
# offers first (db.<ref>.supabase.co:5432) is IPv6-only on the free tier, so
# drizzle-kit fails there with ENETUNREACH from most home connections.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google Cloud console → Credentials → OAuth 2.0 Client ID (Web application).
# Add every origin you actually sign in from as an authorised redirect URI, or
# Google answers redirect_uri_mismatch and the callback never runs:
#   http://localhost:3001/api/auth/callback/google              (dev — 3000 is taken)
#   https://qr-code-attendance-pi.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

# openssl rand -base64 32
# Separate from AUTH_SECRET so session-key rotation does not change stored
# privacy-preserving hashes used for device and network equality checks.
SECURITY_PEPPER=

# Comma-separated. Sign-in is rejected for anything outside these — this is the
# real gate; the `hd` parameter on the Google provider only filters the account
# chooser. Hyderabad only, deliberately: the other campuses run their own
# attendance and a stray Pilani address should not resolve to a course here.
ALLOWED_EMAIL_DOMAINS="hyderabad.bits-pilani.ac.in"

# Comma-separated individual addresses that get in regardless of domain, so a
# personal account can be used for testing without opening the whole of
# gmail.com. Setting this also drops the `hd` hint from the Google flow, since
# that filter would hide the test account from the account chooser.
# Every address here is a permanent hole — leave it empty in production.
ALLOWED_TEST_EMAILS=

# Promoted to admin by `npm run seed:admin`. Comma-separated.
INITIAL_ADMIN_EMAILS=
