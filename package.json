{
  "name": "qr-code-attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/deployMigrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx --env-file=.env.supabase scripts/deployMigrate.ts --force",
    "db:reconcile:prod": "tsx --env-file=.env.supabase scripts/reconcileMigrationLedger.ts --force",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx --env-file=.env.local scripts/seedAdmin.ts",
    "seed:students": "tsx --env-file=.env.local scripts/seedStudents.ts",
    "build:fixtures": "tsx scripts/buildFixtures.ts",
    "test:load": "tsx --env-file=.env.local scripts/loadTest.ts",
    "verify": "npm run build:fixtures && tsx --env-file=.env.local scripts/verifyRoster.ts && tsx --env-file=.env.local scripts/verifyRosterFile.ts && tsx --env-file=.env.local scripts/verifyMark.ts && tsx --env-file=.env.local scripts/verifyReport.ts && tsx --env-file=.env.local scripts/verifySession.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "embedded-postgres@18.4.0-beta.17": true
  }
}
