# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the pooler (port 6543, "Transaction" mode) — used by the app.
# DIRECT_URL is the session pooler (port 5432) — used by drizzle-kit only.
# Both are pooler hosts on purpose. The "Direct connection" string Supabase
# offers first (db.<ref>.supabase.co:5432) is IPv6-only on the free tier, so
# drizzle-kit fails there with ENETUNREACH from most home connections.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google Cloud console → Credentials → OAuth 2.0 Client ID (Web application).
# Add every origin you actually sign in from as an authorised redirect URI, or
# Google answers redirect_uri_mismatch and the callback never runs:
#   http://localhost:3001/api/auth/callback/google              (dev — 3000 is taken)
#   https://qr-code-attendance-pi.vercel.app/api/auth/callback/google
#   https://<the deploy domain>/api/auth/callback/google         (the DADU box)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

# Auth.js v5 infers the callback origin from the request host, but only trusts
# that host automatically on Vercel (which sets VERCEL=1). Behind any other
# reverse proxy it refuses with UntrustedHost and nobody can sign in, so set
# this to true on the self-hosted (Docker) deploy. Leave it unset locally.
AUTH_TRUST_HOST=

# Comma-separated. Sign-in is rejected for anything outside these — this is the
# real gate; the `hd` parameter on the Google provider only filters the account
# chooser. Hyderabad only, deliberately: the other campuses run their own
# attendance and a stray Pilani address should not resolve to a course here.
ALLOWED_EMAIL_DOMAINS="hyderabad.bits-pilani.ac.in"

# Comma-separated individual addresses that get in regardless of domain, so a
# personal account can be used for testing without opening the whole of
# gmail.com. Setting this also drops the `hd` hint from the Google flow, since
# that filter would hide the test account from the account chooser.
# Every address here is a permanent hole — leave it empty in production.
ALLOWED_TEST_EMAILS=

# Promoted to admin by `npm run seed:admin`. Comma-separated. Setting this alone
# does nothing -- the seed script is a manual step, so run it once against prod
# after the box is up (e.g. `docker compose exec dadu-attendance \
# node_modules/.bin/tsx scripts/seedAdmin.ts`).
INITIAL_ADMIN_EMAILS=

# Docker only. docker-compose.yml reads this both to publish the port and to
# tell `next start` what to bind, so the two can never drift. Must be set (an
# empty value fails the build) and not 9090 (dadu-web has that).
PORT=

# Migrations run from the container entrypoint now, so DIRECT_URL (the DDL-capable
# session-pooler role, port 5432) has to be present on the server too -- not just
# locally for drizzle-kit. Without it the app still starts, but applies nothing
# and warns only in the container logs. It is set at the top of this file.
